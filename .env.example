# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 저장소에 올리지 않는다.

# Google AI Studio에서 발급한 Gemini API 키. MOCK_AI=true면 없어도 된다.
GEMINI_API_KEY=

# true면 Gemini를 부르지 않고 명세 4장의 모델 출력 예시로 후처리까지 실행한다(녹음한 세트의 문항 수에 맞춘다).
MOCK_AI=false

# 일반 감정 문항 세트. 비워 두면 set-b(바꿔 말하기 4문항과 상황극 2문항, 60초).
# set-a면 이전 구성(상황극 4문항, 40초)으로 되돌린다. 빌드할 때 화면 코드에 들어가므로 바꾼 뒤 다시 빌드한다.
NEXT_PUBLIC_QUESTION_SET=

# 판정에 쓸 모델. 비워 두면 gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# 첫 시도가 실패하면 재시도 1회를 이 모델로 보낸다. 비워 두면 gemini-3.5-flash-lite.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# 사고 수준: minimal, low, medium, high. 비워 두면 medium.
# gemini-3.8-flash는 low, medium, high만 지원한다(minimal은 오류).
GEMINI_THINKING_LEVEL=medium

# Production에서 필수: Upstash Redis REST 연결 값(호출 제한과 랭킹 저장에 쓴다).
# Vercel Marketplace로 Upstash를 연결하면 KV_REST_API_URL, KV_REST_API_TOKEN이 자동으로 들어가므로
# 따로 넣지 않아도 된다. 직접 넣을 때는 아래 UPSTASH_REDIS_REST_* 쌍을 쓰며, 있으면 이쪽을 먼저 쓴다.
# 읽기 전용 토큰(KV_REST_API_READ_ONLY_TOKEN)은 쓰지 않는다.
# 없으면 Production 감정 요청과 랭킹 API를 거절한다. 단 MOCK_AI=true면 없어도 동작한다
# (호출 제한 없음, 랭킹은 인스턴스 메모리이고 가짜 응답 결과는 등록할 수 없다).
# 로컬 개발에서는 미설정 시 프로세스 메모리를 사용한다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 운영자 토큰: DELETE /api/ranking/{id}에 Authorization: Bearer <값>으로 보낸다.
# 16자 이상이어야 하며, 없거나 짧으면 삭제 요청을 모두 거절한다. 예: openssl rand -hex 32
ADMIN_TOKEN=

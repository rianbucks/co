# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 저장소에 올리지 않는다.

# Google AI Studio에서 발급한 Gemini API 키. MOCK_AI=true면 없어도 된다.
GEMINI_API_KEY=

# true면 Gemini를 부르지 않고 명세 4장의 모델 출력 예시로 후처리까지 실행한다.
MOCK_AI=false

# 판정에 쓸 모델. 비워 두면 gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# 사고 수준: minimal, low, medium, high. 비워 두면 medium.
# gemini-3.8-flash는 low, medium, high만 지원한다(minimal은 오류).
GEMINI_THINKING_LEVEL=medium
